{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dont-queue-at-the-bar",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static site in ./public. Only /api/* and the home page (for absolute social meta URLs)
  // run the Worker; everything else is served as assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },

  // Lets src/worker.js import public/_headers as a string, so its /api responses use the
  // same security headers as the static site without a second copy.
  "rules": [{ "type": "Text", "globs": ["**/_headers"], "fallthrough": true }],

  // Postgres via Hyperdrive (connection pooling + caching in front of your database).
  // Create it with:
  //   npx wrangler hyperdrive create bar-petition --connection-string="postgres://USER:PASS@HOST:5432/DB"
  // then paste the returned id below.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "88c5a2e2902f470995344cd16411c3fc",
      // Used by `wrangler dev` only. Or set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/bar_petition"
    }
  ],

  // Turns away bursts of poll votes from one network before they reach the database
  // (src/worker.js, /api/poll). The daily cap per network is POLL_VOTES_PER_NETWORK_PER_DAY there.
  // namespace_id is any number not used by another rate limiter on the account.
  "ratelimits": [
    { "name": "POLL_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],

  // Daily at 00:05 UTC: deletes the poll's past-day network counts (scheduled() in src/worker.js).
  "triggers": { "crons": ["5 0 * * *"] },

  "observability": { "enabled": true }
}
